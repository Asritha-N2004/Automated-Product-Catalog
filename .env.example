# Copy to .env for Docker. Replace both placeholders before startup.
JWT_SECRET=replace-with-at-least-32-random-characters
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
# Local backend defaults to SQLite. Set this only for local PostgreSQL:
# DATABASE_URL=postgresql+psycopg://grocery:password@localhost:5432/grocery
# CORS_ORIGINS=http://localhost:5173
# RECOMMENDATION_WEIGHTS=[0.30,0.25,0.20,0.15,0.10]
# REDIS_URL=redis://localhost:6379/0
